{
  "name": "xy-parser",
  "version": "6.0.1",
  "description": "Parse a CSV / TSV / whitespace-separated text file containing scientific data (spectrum, diffractogram, chromatogram, …) and return numeric x and y arrays.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "npm run tsc && cheminfo-build --entry lib/index.js --root XYParser",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/xy-parser.git"
  },
  "keywords": [
    "parser",
    "csv",
    "tsv",
    "xy",
    "spectroscopy",
    "mass-spectrometry",
    "chromatography",
    "cheminfo"
  ],
  "author": "Luc Patiny",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cheminfo/xy-parser/issues"
  },
  "homepage": "https://github.com/cheminfo/xy-parser#readme",
  "dependencies": {
    "cheminfo-types": "^1.16.0",
    "ensure-string": "^2.0.0",
    "ml-spectra-processing": "^14.35.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@zakodium/tsconfig": "^1.0.5",
    "cheminfo-build": "^1.4.0",
    "eslint": "^10.10.0",
    "eslint-config-cheminfo-typescript": "^23.0.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
